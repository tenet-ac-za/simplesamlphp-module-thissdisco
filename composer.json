{
    "name": "safire-ac-za/simplesamlphp-module-thissdisco",
    "description": "SimpleSAMLphp module for thiss.io/SeamlessAccess",
    "type": "simplesamlphp-module",
    "keywords": ["simplesamlphp", "thissio", "seamlessaccess", "saml2", "discovery"],
    "license": "MIT",
    "authors": [
        {
            "name": "Guy Halse",
            "homepage": "http://orcid.org/0000-0002-9388-8592"
        }
    ],
    "config": {
        "preferred-install": {
            "simplesamlphp/simplesamlphp": "source",
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "simplesamlphp/composer-module-installer": true,
            "simplesamlphp/composer-xmlprovider-installer": true
        }
    },
    "require": {
        "php": "^8.3",
        "simplesamlphp/assert": "~2.0",
        "simplesamlphp/composer-module-installer": "~1.7",
        "simplesamlphp/simplesamlphp": "~2.5@dev",
        "simplesamlphp/simplesamlphp-assets-jquery": "~2.5",
        "symfony/cache": "^7.4"
    },
    "require-dev": {
        "npm-asset/bootstrap": "~5.3",
        "npm-asset/fortawesome--fontawesome-free": "~6.7",
        "npm-asset/jquery-migrate": "~4.0.2",
        "npm-asset/theidentityselector--thiss-ds": "~3.0.3",
        "simplesamlphp/simplesamlphp-test-framework": "~1.11"
    },
    "suggest": {
        "predis/predis": "Needed if a Redis server is used to store MDQ hash cache",
        "ext-memcache": "Needed if a Memcache server is used to store MDQ hash cache",
        "ext-pdo": "Needed if a database backend is used to store MDQ hash cache"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "sync-npm-assets": "@php tools/sync-npm-assets.php",
        "post-install-cmd": [
            "@sync-npm-assets"
        ],
        "post-update-cmd": [
            "@sync-npm-assets"
        ]
    },
    "extra": {
        "sync-npm-assets-rules": {
            "theidentityselector--thiss-ds": {
                "include": [
                    "dist",
                    "LICENSE.txt"
                ]
            },
            "jquery-migrate": {
                "include": [
                    "dist",
                    "LICENSE.txt"
                ]
            }
        }
    },
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\thissdisco\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimpleSAML\\Test\\Utils\\": "vendor/simplesamlphp/simplesamlphp/tests/Utils"
        }
    },
    "support": {
        "issues": "https://github.com/tenet-ac-za/simplesamlphp-module-thissdisco/issues",
        "source": "https://github.com/tenet-ac-za/simplesamlphp-module-thissdisco"
    }
}
